# Optional web-search keys (server works without them using free scholarly APIs)
# Get a free key to enable broader gov/edu-filtered web search:
# Tavily: https://tavily.com  Brave: https://brave.com/search/api
TAVILY_API_KEY=
BRAVE_API_KEY=
# Contact email for polite Crossref / OpenAlex / NCBI API use (increases rate limit)
CONTACT_EMAIL=you@example.com
# Optional: NCBI API key for higher PubMed rate limits (https://ncbi.nlm.nih.gov/account/)
NCBI_API_KEY=
# Optional: Google Fact Check Tools API key (https://developers.google.com/fact-check/tools/api)
FACTCHECK_API_KEY=
# Optional: override allowlist path (default: ./sources.yaml)
SOURCES_CONFIG=./sources.yaml
